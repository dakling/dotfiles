# Core behavior
set nohidden
set icons
set drawbox
set dirpreviews
set ignorecase
set smartcase
set preview
set ratios 1:2:3
set sortby natural
set info size:time
set ifs "\n"
set scrolloff 8
set findlen 0

# Preview pane
set previewer ~/.config/lf/preview

# Vim-like ergonomics
map gh cd ~
map gu cd ..
map gg top
map G bottom
map . set hidden!

# File operations
map y copy
map d cut
map p paste
map c clear
map D delete
map r rename
map R bulkrename

# Common actions
map o open
map l open
map <enter> open
map e $$EDITOR "$f"
map m push :mkdir<space>
map a push :touch<space>
map Q quit-launch

# Search and filtering
map / search
map ? search-back
map n search-next
map N search-prev
map f find
map F find-back
map <a-f> filter
map zf filter

# fzf jump, if fzf is installed
cmd fzf_jump ${{
    command -v fzf >/dev/null 2>&1 || exit 0
    cd "$(pwd)" || exit 1
    target="$(find . -mindepth 1 2>/dev/null | fzf --height 40% --reverse)"
    if [ -n "$target" ]; then
        lf -remote "send $id select \"$target\""
        lf -remote "send $id open"
    fi
}}
map <c-F> fzf_jump
map <c-p> fzf_jump
map zF fzf_jump
# Fuzzy select only among files and folders in the current directory.
cmd fzf_here ${{
    command -v fzf >/dev/null 2>&1 || exit 0
    cd "$(pwd)" || exit 1
    target="$(find . -mindepth 1 -maxdepth 1 2>/dev/null | sed 's#^\./##' | fzf --height 40% --reverse)"
    if [ -n "$target" ]; then
        lf -remote "send $id select \"$target\""
        lf -remote "send $id open"
    fi
}}
map <c-f> fzf_here

# Open with the platform handler unless it looks like a text file.
cmd open ${{
    case "$(file --mime-type -Lb "$f")" in
        text/*|application/json|application/xml|application/x-shellscript)
            ${EDITOR:-vi} "$f"
            ;;
        *)
            open "$f"
            ;;
    esac
}}

# Quit while keeping the shell in the directory where lf was launched.
cmd quit-launch ${{
    [ -n "$LF_STAY_LAUNCH_FILE" ] && : > "$LF_STAY_LAUNCH_FILE"
    lf -remote "send $id quit"
}}

# Edit selected filenames in $EDITOR, then apply changed lines as renames.
cmd bulkrename ${{
    old="$(mktemp)"
    new="$(mktemp)"
    trap 'rm -f "$old" "$new"' EXIT

    printf '%s\n' $fx > "$old"
    sed 's#^\./##' "$old" > "$new"

    ${EDITOR:-vi} "$new"

    paste "$old" "$new" | while IFS="$(printf '\t')" read -r src dst; do
        [ -z "$dst" ] && continue
        [ "$src" = "$dst" ] && continue
        [ -e "$dst" ] && {
            printf 'Skipping existing target: %s\n' "$dst"
            continue
        }
        mv "$src" "$dst"
    done
}}

# Archive extraction into the current directory.
cmd extract ${{
    set -f
    case "$f" in
        *.tar.bz2|*.tbz2) tar xjf "$f" ;;
        *.tar.gz|*.tgz) tar xzf "$f" ;;
        *.tar.xz|*.txz) tar xJf "$f" ;;
        *.tar) tar xf "$f" ;;
        *.zip) unzip "$f" ;;
        *.rar) unrar x "$f" ;;
        *.7z) 7z x "$f" ;;
        *) printf 'No extractor configured for %s\n' "$f" ;;
    esac
}}
map X extract
