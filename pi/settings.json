{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "codemode": {
    "mode": "on"
  },
  "compaction": {
    "enabled": true,
    "keepRecentTokens": 20000,
    "reserveTokens": 16384
  },
  "defaultModel": "minimax-m3.1-flash:cloud",
  "defaultProvider": "ollama",
  "defaultThinkingLevel": "medium",
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write"
  ],
  "enabledModels": [
    "ollama/minimax-m3.1-flash:cloud",
    "ollama/ornith:9b",
    "ollama/bonsai-27b-32k:latest",
    "ollama/defyma85/bonsai-27b-q1_0:latest"
  ],
  "lastChangelogVersion": "1.3.0",
  "packages": [
    "npm:@ollama/pi-web-search",
    "npm:pi-subagents",
    "npm:pi-lsp",
    "npm:pi-powerline-footer"
  ],
  "showCacheMissNotices": true,
  "theme": "dark",
  "modelThinkingLevels": {
    "mlx-lm/prism-ml/Ternary-Bonsai-27B-mlx-2bit": "high"
  },
  "hideThinkingBlock": false
}